VITE_APP_NAME=Deployment Orchestrator (Local)
VITE_FRONTEND_PORT=3000
VITE_BASE_PATH=/deploymentOrchestrator

# Keep API URLs relative in local development. Vite proxies them to the
# separately running backend, avoiding browser CORS issues between ports.
VITE_BACKEND_URL=
VITE_PROXY_TARGET=http://localhost:8080
