# Local IDE development settings (see .env.development)
VITE_APP_NAME=Deployment Orchestrator (Local)
VITE_FRONTEND_PORT=3000
VITE_BACKEND_URL=
VITE_PROXY_TARGET=http://localhost:8080
VITE_BASE_PATH=/deploymentOrchestrator

# Simulated-QC and QC builds use .env.simqc and .env.qc respectively:
# VITE_APP_NAME=Deployment Orchestrator
# VITE_BASE_PATH=/deploymentOrchestrator
# VITE_BACKEND_URL=   <- leave empty for relative URLs (same-origin deployment)
