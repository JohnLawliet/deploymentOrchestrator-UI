{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],

    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "strict": true,
    "skipLibCheck": true
  },
  "include": ["vite.config.ts", "eslint.config.ts"]
}
