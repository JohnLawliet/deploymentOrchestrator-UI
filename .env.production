# Production build environment — loaded automatically by `vite build`
# VITE_BACKEND_URL is intentionally left empty so the frontend uses relative
# URLs (/deploymentOrchestrator/api/...) and works at any IP/hostname,
# including 192.168.x.x:8080 on the QC VM.
VITE_APP_NAME=Deployment Orchestrator
VITE_BASE_PATH=/deploymentOrchestrator
VITE_BACKEND_URL=
